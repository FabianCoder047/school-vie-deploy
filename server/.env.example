# =====================================================================
# School Vie — configuration serveur. Copier en .env et renseigner.
# AUCUN secret ne doit être commité (.env est dans .gitignore).
# =====================================================================

# --- Serveur ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_vie_db_004774

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Verrouillage du login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# --- Seed : compte Administrateur (lu uniquement par npm run seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur
ADMIN_PRENOM=École
SCHOOL_NAME=School Vie

# --- SMTP (Gmail) — ne JAMAIS committer le vrai mot de passe ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=paulingoudo@gmail.com
SMTP_PASS=
MAIL_FROM="School Vie <no-reply@school-vie.local>"
# true = les mails sont affichés dans la console au lieu d'être envoyés
MAIL_DRY_RUN=true

# --- Lien de réinitialisation de mot de passe (front) ---
RESET_PASSWORD_URL=http://localhost:5173/reinitialiser-mot-de-passe
RESET_TOKEN_EXPIRES_MINUTES=60
