# =====================================================================
# School Vie — configuration du déploiement Docker.
# Copier en .env à la racine de school-app puis : docker compose up -d --build
# =====================================================================

# Port d'accès à l'application (http://localhost:5000)
APP_PORT=5000
CLIENT_URL=http://localhost:5000
# L'API et la SPA sont servies par le même conteneur : laisser /api.
VITE_API_URL=/api

# --- Base locale (par défaut, MariaDB dans le conteneur) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_vie_db_004774
DB_USER=schoolvie
DB_PASSWORD=SchoolVie2026!Db

# Pour réutiliser la base Aiven existante à la place :
# DB_HOST=schoolvie-db004774-fabiodab83-dd5f.g.aivencloud.com
# DB_PORT=18922
# DB_USER=...
# DB_PASSWORD=...
# DB_SSL=true
# DB_SKIP_CREATE_DATABASE=true

# --- Sécurité : À CHANGER ---
JWT_ACCESS_SECRET=changez-access-secret-avant-production
JWT_REFRESH_SECRET=changez-refresh-secret-avant-production

# --- Compte admin initial ---
# Laissez ADMIN_PASSWORD vide pour en générer un au 1er démarrage (affiché dans les logs).
ADMIN_EMAIL=benjaminavoumado38@gmail.com
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur
ADMIN_PRENOM=École
# Second compte admin (garanti à chaque démarrage, sans changement de mot de passe)
ADMIN2_EMAIL=paulingoudo@gmail.com
ADMIN2_PASSWORD=
ADMIN2_NOM=Administrateur
ADMIN2_PRENOM=Vie
SCHOOL_NAME=School Vie
# Passer à true pour réinitialiser le mot de passe admin depuis le .env.
FORCE_SEED=false

# --- E-mails (Brevo SMTP port 2525) ---
MAIL_PROVIDER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSORD=
MAIL_FROM=School Vie <no-reply@school-vie.local>
MAIL_FROM_NAME=School Vie
MAIL_DRY_RUN=true
RESET_PASSWORD_URL=http://localhost:5000/reinitialiser-mot-de-passe
